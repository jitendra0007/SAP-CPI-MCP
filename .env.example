# ── Local development config ──────────────────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# Transport: stdio (local) | sse (BTP CF)
MCP_TRANSPORT=stdio

# Your CPI tenant management node URL (no trailing slash)
CPI_BASE_URL=https://your-tenant.it-cpi001.cfapps.eu10.hana.ondemand.com

# ── Auth: choose ONE of the two options below ─────────────────────────────────

# Option A — Basic Auth (S-user / P-user with CPI API role)
CPI_USERNAME=your_sap_user
CPI_PASSWORD=your_password

# Option B — OAuth2 Client Credentials (service key from 'api' service plan)
# CPI_CLIENT_ID=sb-xxxxxxxx!bNNNN|it-rt-your-tenant!bNNNN
# CPI_CLIENT_SECRET=your_client_secret
# CPI_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token

# Optional tuning
CPI_TIMEOUT_MS=30000
PORT=8080
